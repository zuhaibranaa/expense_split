rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function groupRef(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function groupData(groupId) {
      return get(groupRef(groupId)).data;
    }

    function groupExists(groupId) {
      return exists(groupRef(groupId));
    }

    function isGroupMember(groupId) {
      return signedIn() && uid() in groupData(groupId).get('memberUids', []);
    }

    function isGroupOwner(groupId) {
      return signedIn() && groupData(groupId).get('ownerUid', '') == uid();
    }

    function isGroupAdmin(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(uid()))
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(uid())).data.get('isAdmin', false) == true;
    }

    function isPremium() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.get('isPremium', false) == true;
    }

    function nonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isDefaultCategoryName(name) {
      return name in ['General', 'Food & Drinks', 'Transportation',
        'Entertainment', 'Shopping', 'Utilities', 'Housing', 'Life', 'Other'];
    }

    function validExpense(data) {
      return data.amount is number
        && data.amount > 0
        && nonEmptyString(data.description)
        && data.splits is list
        && data.splits.size() > 0
        && data.memberIds is list
        && data.memberIds.size() > 0
        && nonEmptyString(data.payerId)
        && data.payerId in data.memberIds
        && data.date is timestamp
        && data.isSettlement is bool
        && data.category is string;
    }

    // ---------------------------------------------------------------------
    // users/{uid}
    // ---------------------------------------------------------------------

    match /users/{userId} {
      function isSelf() {
        return signedIn() && uid() == userId;
      }

      function privilegedFieldsUntouched() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isPremium', 'premiumUntil']);
      }

      allow read: if isSelf();

      allow create: if isSelf()
        && request.resource.data.uid == userId
        && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false)
        && (!('premiumUntil' in request.resource.data) || request.resource.data.premiumUntil == null);

      allow update: if isSelf()
        && privilegedFieldsUntouched()
        && request.resource.data.uid == userId;

      allow delete: if isSelf();

      match /devices/{deviceId} {
        allow read, write: if isSelf();
      }
    }

    // ---------------------------------------------------------------------
    // groups/{groupId}
    // ---------------------------------------------------------------------

    match /groups/{groupId} {
      allow read: if signedIn() && uid() in resource.data.get('memberUids', []);

      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && uid() in request.resource.data.memberUids
        && request.resource.data.memberUids.size() > 0
        && nonEmptyString(request.resource.data.name)
        && request.resource.data.type in ['REGULAR', 'PERSONAL'];

      // Owner/admin may update; members may append themselves (invite claim).
      allow update: if signedIn()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          isGroupOwner(groupId)
          || isGroupAdmin(groupId)
          || (
            // Self-join via an invite claim: only memberUids gains this uid.
            request.resource.data.memberUids == resource.data.get('memberUids', []).concat([uid()])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt', 'lastActivityAt'])
          )
        );

      // Owner (or admin) may delete; subcollections are removed client-side.
      allow delete: if isGroupOwner(groupId) || isGroupAdmin(groupId);

      match /members/{memberId} {
        allow read: if isGroupMember(groupId);

        allow create: if signedIn()
          && request.resource.data.isRemoved == false
          && (
            (
              isGroupMember(groupId)
              && request.resource.data.get('uid', null) == null
              && request.resource.data.isAdmin == false
            )
            || (
              memberId == uid()
              && request.resource.data.uid == uid()
              && request.resource.data.isAdmin == true
            )
          );

        // Self-update (own member doc), self-claim (uid was null), or
        // owner/admin (including setting isRemoved).
        allow update: if signedIn()
          && (
            (
              resource.data.get('uid', null) == uid()
              && resource.data.isRemoved == false
              && request.resource.data.uid == resource.data.get('uid', null)
              && request.resource.data.isAdmin == resource.data.isAdmin
              && !request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(['isRemoved'])
            )
            || (
              resource.data.get('uid', null) == null
              && request.resource.data.uid == uid()
              && resource.data.isRemoved == false
            )
            || isGroupOwner(groupId)
            || isGroupAdmin(groupId)
          );

        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && validExpense(request.resource.data)
          && request.resource.data.createdBy == uid();

        allow update: if isGroupMember(groupId)
          && validExpense(request.resource.data)
          && (
            resource.data.createdBy == uid()
            || isGroupOwner(groupId)
            || isGroupAdmin(groupId)
          );

        allow delete: if isGroupMember(groupId)
          && (
            resource.data.createdBy == uid()
            || isGroupOwner(groupId)
            || isGroupAdmin(groupId)
          );
      }

      match /categories/{categoryId} {
        allow read: if isGroupMember(groupId);

        // Premium for custom categories; the nine defaults are seedable by
        // any member (Spark-mode client seeding, D43).
        allow create: if isGroupMember(groupId)
          && nonEmptyString(request.resource.data.name)
          && (isPremium() || isDefaultCategoryName(request.resource.data.name));

        allow update: if isGroupOwner(groupId)
          && nonEmptyString(request.resource.data.name);

        allow delete: if isGroupOwner(groupId);
      }
    }

    // ---------------------------------------------------------------------
    // invites/{token} — capability tokens (D43 Spark mode)
    // ---------------------------------------------------------------------
    // The document id is a 256-bit secret; any signed-in user may read a
    // specific doc (enumeration is infeasible). Create is restricted to
    // members of the referenced group.

    match /invites/{token} {
      allow read: if signedIn() && token.size() >= 32;

      allow create: if signedIn()
        && token.size() >= 32
        && nonEmptyString(request.resource.data.groupId)
        && nonEmptyString(request.resource.data.memberId)
        && request.resource.data.createdBy == uid()
        && isGroupMember(request.resource.data.groupId)
        && request.resource.data.used == false
        && request.resource.data.expiresAt is timestamp;

      // Claim: mark used + record claimer, only while unused & unexpired.
      allow update: if signedIn()
        && resource.data.used == false
        && resource.data.expiresAt > request.time
        && request.resource.data.used == true
        && request.resource.data.claimedBy == uid()
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['used', 'claimedBy']);

      allow delete: if signedIn()
        && (resource.data.createdBy == uid() || isGroupOwner(resource.data.groupId));
    }

    // reminders/{id} — written by Cloud Functions only (unused on Spark)
    match /reminders/{reminderId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // cashInflows/{inflowId}
    // ---------------------------------------------------------------------

    match /cashInflows/{inflowId} {
      allow read: if signedIn() && resource.data.uid == uid();

      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && nonEmptyString(request.resource.data.description)
        && request.resource.data.date is timestamp;

      allow update: if signedIn()
        && resource.data.uid == uid()
        && request.resource.data.uid == uid()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;

      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
